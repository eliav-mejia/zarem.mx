# Copia como .env (ignorado por Git). NUNCA subas valores reales. Ver SECURITY.md.
# Etapa 1 no usa ninguna clave.
#
# 1.1.1 · Etapa 2 (pagos con Stripe). Estos valores NO van en un archivo del sitio: se cargan como secretos de las
# Edge Functions con `supabase secrets set --env-file supabase/functions/.env` (también ignorado por Git).
SITE_URL=https://zarem.mx                    # origen permitido (CORS), success/cancel_url y lectura del catálogo
STRIPE_SECRET_KEY=                           # clave RESTRINGIDA rk_test_… / rk_live_… (permisos en SECURITY.md); nunca sk_
STRIPE_WEBHOOK_SECRET=                       # whsec_… del endpoint webhook-stripe (uno por modo)
STRIPE_LIVEMODE=false                        # true solo en producción; los eventos del otro modo se ignoran
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase en cada Edge Function: no se configuran.
#
# Lo único que conoce el navegador (js/tienda.jsx, público por diseño, sin claves):
#   PAYMENTS_ENDPOINT = 'https://<proyecto>.supabase.co/functions/v1'
#
# Etapas posteriores
MERCADOPAGO_ACCESS_TOKEN=                    # solo servidor (alternativa a Stripe, no usada en 1.1.1)
ORDER_ENDPOINT=                              # Google Apps Script o Worker que recibe copia de cada pedido (Etapa 1)
