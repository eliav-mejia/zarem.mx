# Copia como .env (ignorado por Git). NUNCA subas valores reales.
# Etapa 1 no usa ninguna clave. Etapa 2 (pedidos, pagos y cuentas de empresa):
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_ANON_KEY=<anon-key>                 # pública; la seguridad la da RLS
SUPABASE_SERVICE_ROLE_KEY=                   # solo servidor (Worker / Edge Function)
STRIPE_SECRET_KEY=                           # solo servidor
STRIPE_WEBHOOK_SECRET=                       # solo servidor
MERCADOPAGO_ACCESS_TOKEN=                    # solo servidor
LEAD_ENDPOINT=                               # Google Apps Script o Worker que recibe solicitudes de empresas
